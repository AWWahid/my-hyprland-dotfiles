#!/usr/bin/env bash
# Build DotfilesIconsOutline.ttf and DotfilesIconsFilled.ttf: the waybar dock's app icons,
# at the same codepoints in both (Material Symbols' own, plus the Obsidian gem at U+F8F1),
# so apps.css (personalize) switches the set by font family alone.
# Material Symbols' outlined and -fill SVGs supply them. Where Material draws an icon the
# same either way, the missing half is made here: ringed dots for the outline launcher, a
# solid window and a block arrow for the filled terminal and downloads. The browser takes
# `language` (line globe) as its outline and `public` (solid globe) as its fill. Code stays
# line art in both. The gem is traced from the Obsidian AppImage's own icon.
# Needs: ImageMagick, potrace, fontforge, curl. Build-time only; the .ttf files are committed.
set -euo pipefail

outdir="$HOME/dotfiles/fonts/.local/share/fonts"
appimage="$HOME/.local/opt/obsidian/Obsidian.AppImage"
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT

[ -x "$appimage" ] || { echo "Obsidian AppImage not found at $appimage" >&2; exit 1; }

for n in apps terminal download language public code folder folder-fill \
         note_alt note_alt-fill monitor_heart monitor_heart-fill; do
    curl -fsSL -o "$tmp/$n.svg" "https://cdn.jsdelivr.net/npm/@material-symbols/svg-400/outlined/$n.svg"
done

( cd "$tmp" && "$appimage" --appimage-extract \
    'usr/share/icons/hicolor/512x512/apps/obsidian.png' >/dev/null )
src="$tmp/squashfs-root/usr/share/icons/hicolor/512x512/apps/obsidian.png"

# Same tile removal as obsidian-update, giving the bare gem on transparency.
box=$(magick "$src" -colorspace HSL -channel G -separate +channel -threshold 25% -format '%@' info:)
magick "$src" \
    -fuzz 22% -fill none -draw 'alpha 5,5 floodfill' \
    -fuzz 22% -fill none -draw 'alpha 60,60 floodfill' \
    -crop "$box" +repage -trim +repage \
    -background none -gravity center -extent '%[fx:max(w,h)]x%[fx:max(w,h)]' "$tmp/gem.png"

# A font glyph is one colour, so the gem's facets have to be drawn as lines. Each facet is
# a smooth gradient and the boundaries between them are hard steps, so an edge filter picks
# out the facet lines and little else.
# STROKE is in source pixels on a ~421px gem: 9 breaks up at bar size, 21 turns chunky.
# Filled: the silhouette with the lines cut out, stopping short of the outline so the glyph
# stays one shape. Outline: the inverse, a silhouette ring of the same width plus the lines.
STROKE=17
R=$(( STROKE / 2 ))
magick "$tmp/gem.png" -alpha extract -threshold 50% "$tmp/sil.png"
magick "$tmp/gem.png" -alpha remove -alpha off -colorspace Gray \
    -morphology EdgeOut Diamond:1 -auto-level -threshold 15% "$tmp/lines.png"
magick "$tmp/sil.png" -morphology Erode Disk:$(( R + 2 )) "$tmp/interior.png"
magick "$tmp/lines.png" "$tmp/interior.png" -compose Multiply -composite \
    -morphology Dilate Disk:$R "$tmp/facets.png"
magick "$tmp/sil.png" \( "$tmp/facets.png" -negate \) -compose Multiply -composite \
    -threshold 50% -negate -bordercolor white -border 4 "$tmp/gem-filled.pbm"
# +compose: -border composites with the current -compose, and Lighten would whiten it all
magick "$tmp/sil.png" \( "$tmp/sil.png" -morphology Erode Disk:$STROKE -negate \) \
    -compose Multiply -composite "$tmp/facets.png" -compose Lighten -composite \
    +compose -threshold 50% -negate -bordercolor white -border 4 "$tmp/gem-outline.pbm"
for v in filled outline; do
    potrace --svg --alphamax 1.0 --turdsize 8 -o "$tmp/gem-$v.svg" "$tmp/gem-$v.pbm"
done

# The filled downloads arrow: Material's tip and 45° head, with a shaft as wide as the head is deep
cat > "$tmp/download-fill.svg" <<'SVG'
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960"><path d="M480-313 270-523h130v-277h160v277h130L480-313ZM220-160q-24 0-42-18t-18-42v-143h60v143h520v-143h60v143q0 24-18 42t-42 18H220Z"/></svg>
SVG

fontforge -quiet -lang=py -script /dev/stdin "$tmp" "$outdir" <<'PY'
import sys, fontforge, psMat
tmp, outdir = sys.argv[1:3]

# Material Symbols' own metrics, so the dock shares the rest of the bar's baseline and size
EM, ASCENT, DESCENT = 960, 768, 192
WIDTH, BOX, CX, CY = 960, 800, 480, 480   # the gem fits an 800x800 box centred at (480,480)

# codepoint: (outline, filled) SVG names
ICONS = {
    0xE5C3: ("apps", "apps"),                        # launcher (outline ringed below)
    0xE2C7: ("folder", "folder-fill"),               # files
    0xEB8E: ("terminal", "terminal"),                # terminal (filled made solid below)
    0xF090: ("download", "download-fill"),           # downloads (fill drawn above)
    0xE80B: ("language", "public"),                  # browser
    0xE86F: ("code", "code"),                        # Zed
    0xF040: ("note_alt", "note_alt-fill"),           # notepad
    0xEAA2: ("monitor_heart", "monitor_heart-fill"), # activity
}

def new_font(style):
    f = fontforge.font()
    f.fontname = "DotfilesIcons-" + style
    f.familyname = f.fullname = "Dotfiles Icons " + style
    f.em, f.ascent, f.descent = EM, ASCENT, DESCENT
    f.encoding = "UnicodeFull"
    # Copy Material Symbols' vertical metrics verbatim, so a line mixing the fonts gets one
    # line box and one baseline.
    f.hhea_ascent, f.hhea_descent, f.hhea_linegap = 1056, -96, 0
    f.os2_typoascent, f.os2_typodescent, f.os2_typolinegap = 1056, -96, 0
    f.os2_winascent, f.os2_windescent = 1062, 91
    for a in ("hhea_ascent_add", "hhea_descent_add",
              "os2_typoascent_add", "os2_typodescent_add",
              "os2_winascent_add", "os2_windescent_add"):
        setattr(f, a, False)
    return f

def ring_dots(g):
    # Each dot gets a hole, leaving a ring about as thick as Material's 60-unit stroke
    layer = fontforge.layer()
    for c in g.foreground:
        xmin, ymin, xmax, ymax = c.boundingBox()
        cx, cy, d = (xmin + xmax) / 2, (ymin + ymax) / 2, xmax - xmin
        hole = c.dup()
        hole.transform(psMat.compose(psMat.translate(-cx, -cy), psMat.compose(
            psMat.scale((d - 100) / d), psMat.translate(cx, cy))))
        layer += c
        layer += hole.reverseDirection()
    g.foreground = layer

def solid_window(g):
    # Material's terminal is the window frame (outer edge minus the content area) plus ">_";
    # dropping the content area fills the window, and ">_" nests inside it as cut-outs
    contours = sorted(g.foreground, key=lambda c: -(c.boundingBox()[2] - c.boundingBox()[0]))
    layer = fontforge.layer()
    layer += contours[0]
    for c in contours[2:]: layer += c
    g.foreground = layer
    g.correctDirection()

for style, pick in (("Outline", 0), ("Filled", 1)):
    f = new_font(style)
    for cp, names in ICONS.items():
        g = f.createChar(cp)
        g.importOutlines(f"{tmp}/{names[pick]}.svg")
        g.transform(psMat.translate(0, -768))   # SVG's viewBox 0 -960 lands 768 high
        g.width = WIDTH
    if style == "Outline": ring_dots(f[0xE5C3])
    else: solid_window(f[0xEB8E])

    g = f.createChar(0xF8F1, "obsidian")
    g.importOutlines(f"{tmp}/gem-{style.lower()}.svg")
    g.removeOverlap()
    g.correctDirection()
    xmin, ymin, xmax, ymax = g.boundingBox()
    g.transform(psMat.scale(BOX / max(xmax - xmin, ymax - ymin)))
    xmin, ymin, xmax, ymax = g.boundingBox()
    g.transform(psMat.translate(CX - (xmin + xmax) / 2, CY - (ymin + ymax) / 2))
    g.width = WIDTH

    out = f"{outdir}/DotfilesIcons{style}.ttf"
    f.generate(out)
    print("wrote", out)
PY
