#!/bin/sh
# $EDITOR: Zed in a graphical session (waits for the tab to close, as git and sudoedit expect),
# nano on a bare TTY, where Zed can't open. Never vi.
# Arch names Zed's command zeditor; Zed's own installer and other distros name it zed
zed=$(command -v zeditor || command -v zed)
[ -n "$WAYLAND_DISPLAY" ] && [ -n "$zed" ] && exec "$zed" --wait "$@"
exec nano "$@"
