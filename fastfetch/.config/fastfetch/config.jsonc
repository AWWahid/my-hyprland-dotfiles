// Terminal greeting (fish_greeting). The logo is passed on the command line: personalize's Terminal pane picks it.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    // Width only: the height follows the picture's shape (setting both stretches it; preserveAspectRatio is iTerm-only)
    "width": 30,
    "padding": { "top": 1, "left": 1, "right": 3 }
  },
  "display": {
    "separator": "  ",
    // Palette slot 16 is the accent (theme-toggle.sh writes it into kitty's colors), so open terminals follow it
    "color": { "keys": "38;5;16", "title": "38;5;16" },
    "key": { "type": "both" }
  },
  "modules": [
    "break",
    "title",
    "os",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "memory"
  ]
}
