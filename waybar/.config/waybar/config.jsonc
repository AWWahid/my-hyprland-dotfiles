{
    "layer": "top",
    "position": "bottom",
    "height": 39,
    "modules-left": [
        "custom/power",
        "hyprland/workspaces"
    ],
    "modules-center": [
        "group/dock"
    ],
    "modules-right": [
        "group/traydrawer",
        "network",
        "pulseaudio",
        "battery",
        "clock",
        "custom/notifications"
    ],
    "group/dock": {
        "orientation": "horizontal",
        "modules": [
            "custom/files",
            "custom/terminal",
            "custom/firefox",
            "custom/zed",
            "custom/notepad"
        ]
    },
    "custom/files": {
        "format": "\ue2c7",
        "tooltip-format": "Files",
        "on-click": "kitty -c ~/.config/kitty/yazi.conf -e yazi"
    },
    "custom/terminal": {
        "format": "\ueb8e",
        "tooltip-format": "Terminal",
        "on-click": "kitty"
    },
    "custom/firefox": {
        "format": "\ue80b",
        "tooltip-format": "Firefox",
        "on-click": "firefox"
    },
    "custom/zed": {
        "format": "\ue86f",
        "tooltip-format": "Zed",
        "on-click": "~/.local/bin/zed"
    },
    "custom/notepad": {
        "format": "\uf040",
        "tooltip-format": "Notepad",
        "on-click": "mousepad"
    },
    "clock": {
        "format": "{:%a %d %b  %I:%M %p}",
        "interval": 60,
        "tooltip-format": "<tt>{calendar}</tt>"
    },
    "custom/notifications": {
        "exec": "~/.config/hypr/scripts/notifications.sh status",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "on-click": "~/.config/hypr/scripts/notifications.sh centre",
        "on-click-right": "~/.config/hypr/scripts/notifications.sh dnd"
    },
    "pulseaudio": {
        "format": "<span size='20.25pt' rise='-2.25pt' font_family='Material Symbols Filled'>{icon}</span> <span rise='5.25pt'>{volume}%</span>",
        "format-muted": "<span size='20.25pt' rise='-2.25pt' font_family='Material Symbols Filled'>\ue04f</span> <span rise='5.25pt'>muted</span>",
        "format-icons": {
            "default": [
                "\ue04e",
                "\ue04d",
                "\ue050"
            ]
        },
        "scroll-step": 5,
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
    "network": {
        "format-wifi": "{icon}",
        "format-ethernet": "\ueb2f",
        "format-disconnected": "\uf064",
        "format-disabled": "\ue648",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
        "on-click": "~/.config/hypr/scripts/wifi-menu.sh",
        "format-icons": [
            "\uebe4",
            "\uebd6",
            "\uebe1",
            "\uf065"
        ]
    },
    "bluetooth": {
        "format": "\ue1a7",
        "format-off": "\ue1a9",
        "format-disabled": "\ue1a9",
        "format-connected": "\ue1a8",
        "format-no-controller": "",
        "tooltip-format-connected": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "on-click": "~/.config/hypr/scripts/bt-menu.sh"
    },
    "battery": {
        "bat": "BAT0",
        "interval": 60,
        "states": {
            "warning": 20,
            "critical": 10
        },
        "format": "<span size='20.25pt' rise='-2.25pt' font_family='Material Symbols Filled'>{icon}</span> <span rise='5.25pt'>{capacity}%</span>",
        "format-charging": "<span size='20.25pt' rise='-2.25pt' font_family='Material Symbols Filled'>\ue1a3</span> <span rise='5.25pt'>{capacity}%</span>",
        "format-plugged": "<span size='20.25pt' rise='-2.25pt' font_family='Material Symbols Filled'>\ue63c</span> <span rise='5.25pt'>{capacity}%</span>",
        "format-icons": [
            "\uf09c",
            "\uf09e",
            "\uf0a0",
            "\uf0a1",
            "\ue1a5"
        ],
        "tooltip-format": "{timeTo}"
    },
    "custom/power": {
        "format": "\uf8c7",
        "tooltip": false,
        "on-click": "~/.config/hypr/scripts/powermenu.sh"
    },
    "group/traydrawer": {
        "orientation": "horizontal",
        "modules": [
            "custom/expand",
            "bluetooth",
            "tray"
        ],
        "drawer": {
            "click-to-reveal": true,
            "transition-left-to-right": false,
            "transition-duration": 200,
            "children-class": "drawer-child"
        }
    },
    "custom/expand": {
        "format": "\ue5cb",
        "tooltip-format": "Hidden icons"
    },
    "tray": {
        "spacing": 12,
        "icon-size": 24
    }
}
