{
    "layer": "top",
    "position": "bottom",
    "height": 39,
    "modules-left": [
        "custom/power",
        "hyprland/workspaces"
    ],
    "modules-center": [
        "group/dock"
    ],
    "modules-right": [
        "custom/recording",
        "group/traydrawer",
        "network",
        "pulseaudio",
        "battery",
        "clock",
        "custom/notifications"
    ],
    "group/dock": {
        "orientation": "horizontal",
        "modules": [
            "custom/launcher",
            "custom/files",
            "custom/terminal",
            "custom/downloads",
            "custom/firefox",
            "custom/zed",
            "custom/notepad",
            "custom/obsidian",
            "custom/activity"
        ]
    },
    "custom/launcher": {
        "format": "\ue5c3",
        "tooltip-format": "Launcher",
        "on-click": "pkill -x fuzzel || fuzzel"
    },
    "custom/files": {
        "format": "\ue2c7",
        "tooltip-format": "Files",
        "on-click": "yazi-window ~/.local/state/yazi/quick-access"
    },
    "custom/terminal": {
        "format": "\ueb8e",
        "tooltip-format": "Terminal",
        "on-click": "kitty"
    },
    "custom/firefox": {
        "format": "\ue80b",
        "tooltip-format": "Firefox",
        "on-click": "flatpak run org.mozilla.firefox"
    },
    "custom/downloads": {
        "format": "\uf090",
        "tooltip-format": "Downloads",
        "on-click": "~/.config/hypr/scripts/downloads.sh"
    },
    "custom/zed": {
        "format": "\ue86f",
        "tooltip-format": "Zed",
        "on-click": "~/.local/bin/zed"
    },
    "custom/obsidian": {
        "format": "\uf8f1",
        "tooltip-format": "Obsidian",
        "on-click": "~/.local/opt/obsidian/Obsidian.AppImage --ozone-platform-hint=auto --enable-features=WaylandWindowDecorations"
    },
    "custom/activity": {
        "format": "\ueaa2",
        "tooltip-format": "Activity Monitor\nClick: processes · Right-click: performance",
        "on-click": "~/.config/hypr/scripts/activity-monitor.sh 1",
        "on-click-right": "~/.config/hypr/scripts/activity-monitor.sh 2"
    },
    "custom/notepad": {
        "format": "\uf040",
        "tooltip-format": "Notepad",
        "on-click": "mousepad"
    },
    "clock": {
        "format": "{:%a %d %b  %I:%M %p}",
        "interval": 60,
        "tooltip": false,
        "on-click": "pkill -x calendar-popup || calendar-popup"
    },
    "custom/notifications": {
        "exec": "~/.config/hypr/scripts/notifications.sh status",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "on-click": "~/.config/hypr/scripts/notifications.sh centre",
        "on-click-right": "~/.config/hypr/scripts/notifications.sh dnd"
    },
    "pulseaudio": {
        "format": "<span size='20.25pt' rise='-2.25pt' font_family='Material Symbols Filled'>{icon}</span> <span rise='5.25pt'>{volume}%</span>",
        "format-muted": "<span size='20.25pt' rise='-2.25pt' font_family='Material Symbols Filled'>\ue04f</span> <span rise='5.25pt'>muted</span>",
        // 20 slots = 5% bands: under 5% the speaker has no waves, up to 50% one wave, above that full
        "format-icons": {
            "default": [
                "\ue04e",
                "\ue04d",
                "\ue04d",
                "\ue04d",
                "\ue04d",
                "\ue04d",
                "\ue04d",
                "\ue04d",
                "\ue04d",
                "\ue04d",
                "\ue050",
                "\ue050",
                "\ue050",
                "\ue050",
                "\ue050",
                "\ue050",
                "\ue050",
                "\ue050",
                "\ue050",
                "\ue050"
            ]
        },
        "scroll-step": 5,
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
    "network": {
        "format-wifi": "{icon}",
        "format-ethernet": "\ueb2f",
        "format-disconnected": "\uf064",
        "format-disabled": "\ue648",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
        "on-click": "~/.config/hypr/scripts/wifi-menu.sh",
        "format-icons": [
            "\uebe4",
            "\uebd6",
            "\uebe1",
            "\uf065"
        ]
    },
    "bluetooth": {
        "format": "\ue1a7",
        "format-off": "\ue1a9",
        "format-disabled": "\ue1a9",
        "format-connected": "\ue1a8",
        "format-no-controller": "",
        "tooltip-format-connected": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "on-click": "~/.config/hypr/scripts/bt-menu.sh"
    },
    "battery": {
        "interval": 60,
        "states": {
            "low": 20
        },
        "format": "<span size='20.25pt' rise='-2.25pt' font_family='Material Symbols Filled'>{icon}</span> <span rise='5.25pt'>{capacity}%</span>",
        "format-charging": "<span size='20.25pt' rise='-2.25pt' font_family='Material Symbols Filled'>\ue1a3</span> <span rise='5.25pt'>{capacity}%</span>",
        "format-plugged": "<span size='20.25pt' rise='-2.25pt' font_family='Material Symbols Filled'>\ue63c</span> <span rise='5.25pt'>{capacity}%</span>",
        "format-icons": [
            "\uf09c",
            "\uf09e",
            "\uf0a0",
            "\uf0a1",
            "\ue1a5"
        ],
        "tooltip-format": "{timeTo}",
        "on-click": "~/.config/hypr/scripts/power-mode.sh"
    },
    "custom/power": {
        "format": "\uf8c7",
        "tooltip": false,
        "on-click": "pkill -x fuzzel || ~/.config/hypr/scripts/power-button-menu.sh"
    },
    "group/traydrawer": {
        "orientation": "horizontal",
        "modules": [
            "custom/expand",
            "bluetooth",
            "custom/nightshift",
            "tray"
        ],
        "drawer": {
            "click-to-reveal": true,
            "transition-left-to-right": false,
            "transition-duration": 200,
            "children-class": "drawer-child"
        }
    },
    "custom/recording": {
        "exec": "~/.config/hypr/scripts/record.sh status",
        "return-type": "json",
        "interval": "once",
        "signal": 10,
        "on-click": "~/.config/hypr/scripts/record.sh stop"
    },
    "custom/nightshift": {
        "exec": "~/.config/hypr/scripts/nightshift.sh",
        "return-type": "json",
        "interval": "once",
        "signal": 9,
        "on-click": "~/.config/hypr/scripts/nightshift.sh toggle",
        "on-scroll-up": "~/.config/hypr/scripts/nightshift.sh warmer",
        "on-scroll-down": "~/.config/hypr/scripts/nightshift.sh cooler"
    },
    "custom/expand": {
        "format": "\ue5cb",
        "tooltip-format": "Hidden icons"
    },
    "tray": {
        "spacing": 12,
        "icon-size": 24
    }
}
