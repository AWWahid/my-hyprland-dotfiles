# Local secret keys & environment tokens
*secret*
*.key
*.pem
.env

# System & runtime logs
*.log
*.tmp
*.bak

# Hardware/Device specific local overrides
*.local
!icons/.local
!kitty/.local
!bash/.local
!fonts/.local

# OS garbage
.DS_Store
thumbs.db

#AI files
.claude/
CLAUDE.md
AGENTS.md
!zed/.config/zed/settings.json

# Installed at their latest version, never pinned (install commands in CLAUDE.md):
# uosc (its installer writes scripts, fonts and a default uosc.conf through the stow link)
mpv/.config/mpv/scripts/
mpv/.config/mpv/fonts/
mpv/.config/mpv/script-opts/uosc.conf
mpv/.config/mpv/.uosc-backup/
# yazi plugins from `ya pkg add` (package.toml records the revision it installed)
yazi/.config/yazi/package.toml
yazi/.config/yazi/plugins/yamb.yazi/
yazi/.config/yazi/plugins/mount.yazi/
# Generated by theme-toggle.sh
firefox/chrome/colors.css
# Rust apps resolve the newest compatible crates on each `cargo install`
Cargo.lock
