// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "session": {
    "trust_all_worktrees": true
  },
  "base_keymap": "VSCode",
  "ui_font_family": "Inter",
  "ui_font_size": 19,
  "buffer_font_family": "Geist Mono",
  "buffer_font_size": 20,
  "buffer_line_height": "standard",
  // No moving files by dragging in the file tree: a slip moved a whole folder once. Cut/copy/paste still work
  "project_panel": { "dock": "left", "drag_and_drop": false },
  "theme": {
    "mode": "system",
    "light": "GitHub Pure Light",
    "dark": "GitHub Pure Dark",
  },
  // themes/github-pure.json: github.com's syntax and UI colors (Primer) on pure black / pure white,
  // which Hyprland's window opacity and blur show through
}
