# Read the battery's uevent on AC plug/unplug so waybar's inotify watch refreshes instantly.
# Matches any mains charger (ADP1, AC, ACAD...) and every BAT*, so it is not tied to one laptop's names.
SUBSYSTEM=="power_supply", ENV{POWER_SUPPLY_TYPE}=="Mains", ACTION=="change", RUN+="/bin/sh -c 'cat /sys/class/power_supply/BAT*/uevent'"
# On unplug the battery still reads "Charging" for ~1.5s and flips to "Discharging" without an event,
# so read again after it settles. Waits inline: udev kills background children and blocks systemd-run.
SUBSYSTEM=="power_supply", ENV{POWER_SUPPLY_TYPE}=="Mains", ACTION=="change", ENV{POWER_SUPPLY_ONLINE}=="0", RUN+="/bin/sh -c 'sleep 2; cat /sys/class/power_supply/BAT*/uevent; sleep 2; cat /sys/class/power_supply/BAT*/uevent'"
